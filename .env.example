# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Admin User IDs (optional - comma-separated list of user IDs who can use commands)
# Example: ADMIN_IDS=123456789,987654321,555555555
ADMIN_IDS=

# Group Chat ID where users will be kicked from on deauth/expiry
GROUP_CHAT_ID=

# Log Chat ID where all events will be logged
LOG_CHAT_ID=
